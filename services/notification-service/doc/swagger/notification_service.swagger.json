            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "templateKey",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "admin-email-templates"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "[Admin] Update an email template",
        "operationId": "NotificationService_UpdateEmailTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/notificationEmailTemplate"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "templateKey",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NotificationServiceUpdateEmailTemplateBody"
            }
          }
        ],
        "tags": [
          "admin-email-templates"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/notifications/admin/email-templates/{templateKey}:preview": {
      "post": {
        "summary": "[Admin] Render a template with sample data",
        "operationId": "NotificationService_PreviewEmailTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
