  "paths": {
    "/v1/notifications/admin/email-templates": {
      "get": {
        "summary": "[Admin] List all email templates",
        "operationId": "NotificationService_ListEmailTemplates",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/notificationListEmailTemplatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "admin-email-templates"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/notifications/admin/email-templates/{templateKey}": {
      "get": {
        "summary": "[Admin] Get one email template",
        "operationId": "NotificationService_GetEmailTemplate",
