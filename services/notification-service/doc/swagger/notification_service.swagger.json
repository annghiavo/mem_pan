          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "templateKey",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NotificationServicePreviewEmailTemplateBody"
            }
          }
        ],
        "tags": [
          "admin-email-templates"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
