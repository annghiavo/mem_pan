  "paths": {
    "/v1/notifications/devices": {
      "post": {
        "summary": "Register a device FCM token",
        "operationId": "NotificationService_RegisterDeviceToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/notificationRegisterDeviceTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/notificationRegisterDeviceTokenRequest"
            }
          }
        ],
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/notifications/devices/{token}": {
      "delete": {
        "summary": "Unregister a device FCM token",
        "operationId": "NotificationService_UnregisterDeviceToken",
        "responses": {
