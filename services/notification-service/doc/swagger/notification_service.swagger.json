          }
        ],
        "tags": [
          "admin-email-templates"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/notifications/devices": {
      "post": {
        "summary": "Register a device FCM token",
        "operationId": "NotificationService_RegisterDeviceToken",
        "responses": {
          "200": {
            "description": "A successful response.",
