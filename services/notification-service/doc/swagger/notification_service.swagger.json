            "type": "string"
          }
        }
      }
    },
    "NotificationServiceSendTestEmailBody": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "NotificationServiceUpdateEmailTemplateBody": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "htmlBody": {
          "type": "string"
        },
        "textBody": {
          "type": "string"
        }
      }
    },
    "notificationEmailTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "templateKey": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "htmlBody": {
          "type": "string"
        },
        "textBody": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isActive": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "format": "int32"
        },
        "updatedBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "notificationListEmailTemplatesResponse": {
      "type": "object",
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/notificationEmailTemplate"
          }
        }
      }
    },
    "notificationPreviewEmailTemplateResponse": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "htmlBody": {
          "type": "string"
        },
        "textBody": {
          "type": "string"
        }
      }
    },
    "notificationRegisterDeviceTokenRequest": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        }
      }
    },
    "notificationRegisterDeviceTokenResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "notificationSendTestEmailResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "notificationSendTestNotificationRequest": {
      "type": "object",
      "properties": {
        "notificationType": {
          "type": "string",
          "description": "\"study_reminder\" (default) or \"streak_warning\". Controls title + body\ncopy and the `type` field in the data payload — matches what the cron\nproduces in production."
        },
        "token": {
          "type": "string",
          "description": "Optional. If empty, the push is sent to ALL FCM tokens registered for\nthe caller. If set, sent only to this token (useful before the device is\nregistered, or for ad-hoc QA on someone else's handset)."
        },
        "dueCount": {
          "type": "integer",
          "format": "int32",
          "description": "Fake values used to render the body. Defaults: due_count=5, streak=0."
        },
        "streak": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "notificationSendTestNotificationResponse": {
      "type": "object",
      "properties": {
        "deviceCount": {
          "type": "integer",
          "format": "int32",
          "title": "how many tokens we attempted to send to"
        },
        "title": {
          "type": "string",
          "title": "echo of the rendered title"
        },
        "body": {
          "type": "string",
          "title": "echo of the rendered body"
        }
      }
    },
    "notificationUnregisterDeviceTokenResponse": {
      "type": "object"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  },
