            }
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
