  "paths": {
    "/v1/study/decks/recent": {
      "get": {
        "summary": "Get list of recently studied decks ordered by last access",
        "operationId": "StudyService_GetRecentDecks",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/studyGetRecentDecksResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "study"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/study/decks/{deckId}/check-answer": {
      "post": {
        "summary": "Check a written answer against the correct answer using deck grading settings",
        "operationId": "StudyService_CheckAnswer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/studyCheckAnswerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "deckId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StudyServiceCheckAnswerBody"
            }
          }
        ],
        "tags": [
          "study"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/study/decks/{deckId}/progress": {
      "get": {
        "summary": "Get card progress counts for a deck (new/studying/memorized)",
