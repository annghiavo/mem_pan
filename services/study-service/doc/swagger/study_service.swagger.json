            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StudyServiceUpdateDeckSettingsBody"
            }
          }
        ],
        "tags": [
          "study"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
