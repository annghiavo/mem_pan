  "definitions": {
    "StudyServiceCheckAnswerBody": {
      "type": "object",
      "properties": {
        "userAnswer": {
          "type": "string"
        },
        "correctAnswer": {
          "type": "string"
        }
      }
    },
    "StudyServiceFinishSessionBody": {
      "type": "object"
    },
    "StudyServiceReviewCardBody": {
      "type": "object",
      "properties": {
        "cardId": {
          "type": "string"
        },
        "rating": {
          "type": "integer",
          "format": "int32"
        },
        "durationMs": {
          "type": "integer",
          "format": "int32"
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone of the device at review time. Optional but recommended —\nused for streak boundary and activity-histogram bucketing."
        }
      }
    },
    "StudyServiceUpdateDeckSettingsBody": {
      "type": "object",
      "properties": {
        "settings": {
          "$ref": "#/definitions/studyStudySettings"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "studyCheckAnswerResponse": {
      "type": "object",
      "properties": {
        "isCorrect": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "studyDeckProgressResponse": {
      "type": "object",
      "properties": {
        "deckId": {
          "type": "string"
        },
        "newCount": {
          "type": "integer",
          "format": "int32"
        },
        "learnCount": {
          "type": "integer",
          "format": "int32"
        },
        "memorizedCount": {
          "type": "integer",
          "format": "int32"
        },
        "totalCount": {
          "type": "integer",
          "format": "int32"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/studyProgressTag"
          }
        },
        "nextReviewDate": {
          "type": "string",
          "format": "date-time",
          "description": "Soonest next_review_date among the user's non-new cards in this deck.\nUnset when the deck has no scheduled (non-new) cards yet. The client\nrenders the countdown from this absolute timestamp."
        },
        "dueNow": {
          "type": "integer",
          "format": "int32",
          "description": "Number of non-new cards already due (next_review_date \u003c= now)."
        }
      }
    },
    "studyDueCard": {
      "type": "object",
      "properties": {
        "cardId": {
          "type": "string"
        },
        "deckId": {
          "type": "string"
        },
