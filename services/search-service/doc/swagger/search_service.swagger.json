{
  "swagger": "2.0",
  "info": {
    "title": "Search Service API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "SearchService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/search/cards": {
      "get": {
        "summary": "Search cards owned by the caller (optionally scoped to a deck).",
        "operationId": "SearchService_SearchCards",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/searchSearchCardsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "deckId",
            "description": "optional; if set, results are filtered to this deck",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "search"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/search/decks": {
      "get": {
        "summary": "Search decks (public by default; pass scope=mine for caller's own).",
        "operationId": "SearchService_SearchDecks",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/searchSearchDecksResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "DECK_SCOPE_UNSPECIFIED",
              "DECK_SCOPE_PUBLIC",
              "DECK_SCOPE_MINE",
              "DECK_SCOPE_ALL"
            ],
            "default": "DECK_SCOPE_UNSPECIFIED"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "search"
        ]
      }
    },
    "/v1/search/folders": {
      "get": {
        "summary": "Search folders (public by default; pass scope=mine for caller's own).",
        "operationId": "SearchService_SearchFolders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/searchSearchFoldersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "FOLDER_SCOPE_UNSPECIFIED",
              "FOLDER_SCOPE_PUBLIC",
              "FOLDER_SCOPE_MINE",
              "FOLDER_SCOPE_ALL"
            ],
            "default": "FOLDER_SCOPE_UNSPECIFIED"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "search"
        ]
      }
    },
    "/v1/search/users": {
      "get": {
        "summary": "Search users by username or full name.",
        "operationId": "SearchService_SearchUsers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/searchSearchUsersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "search"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "searchCard": {
      "type": "object",
      "properties": {
        "cardId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "deckId": {
          "type": "string"
        },
        "noteId": {
          "type": "string"
        },
        "contentFront": {
          "type": "string"
        },
        "contentBack": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "score": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "searchDeck": {
      "type": "object",
      "properties": {
        "deckId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isPublic": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "cardCount": {
          "type": "integer",
          "format": "int32"
        },
        "clonedFrom": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "score": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "searchDeckSearchScope": {
      "type": "string",
      "enum": [
        "DECK_SCOPE_UNSPECIFIED",
        "DECK_SCOPE_PUBLIC",
        "DECK_SCOPE_MINE",
        "DECK_SCOPE_ALL"
      ],
      "default": "DECK_SCOPE_UNSPECIFIED"
    },
    "searchFolder": {
      "type": "object",
      "properties": {
        "folderId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "score": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "searchFolderSearchScope": {
      "type": "string",
      "enum": [
        "FOLDER_SCOPE_UNSPECIFIED",
        "FOLDER_SCOPE_PUBLIC",
        "FOLDER_SCOPE_MINE",
        "FOLDER_SCOPE_ALL"
      ],
      "default": "FOLDER_SCOPE_UNSPECIFIED"
    },
    "searchSearchCardsResponse": {
      "type": "object",
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/searchCard"
          }
        },
        "total": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "searchSearchDecksResponse": {
      "type": "object",
      "properties": {
        "decks": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/searchDeck"
          }
        },
        "total": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "searchSearchFoldersResponse": {
      "type": "object",
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/searchFolder"
          }
        },
        "total": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "searchSearchUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/searchUser"
          }
        },
        "total": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "searchUser": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "score": {
          "type": "number",
          "format": "double"
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
