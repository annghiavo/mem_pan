# Copy to app.env for local development.
DATABASE_URL=

GRPC_SERVER_ADDRESS=:9098
HTTP_SERVER_ADDRESS=:8088
AUTH_SERVICE_ADDRESS=localhost:9090

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn

# Separate PayOS disbursement channel credentials for Chi/payout APIs.
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# Public web URL that end users open in the browser. Do not use an internal
# Docker hostname or a LAN IP here unless that is truly the public address.
APP_BASE_URL=https://app.example.com
PAYOS_RETURN_URL=https://app.example.com/billing/return
PAYOS_CANCEL_URL=https://app.example.com/billing/cancel

PLUS_MONTHLY_AMOUNT_VND=49000
PLUS_YEARLY_AMOUNT_VND=490000
