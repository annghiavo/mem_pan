{
  "swagger": "2.0",
  "info": {
    "title": "Admin Service API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "AdminService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/admin/decks/{deckId}/status": {
      "patch": {
        "summary": "[Admin] Hide or delete the offending deck",
        "operationId": "AdminService_UpdateDeckStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminUpdateDeckStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "deckId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminServiceUpdateDeckStatusBody"
            }
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/reports": {
      "get": {
        "summary": "[Admin] See list of reports",
        "operationId": "AdminService_ListReports",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminListReportsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "statusFilter",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/reports/{reportId}": {
      "patch": {
        "summary": "[Admin] Report processing (resolve/dismiss)",
        "operationId": "AdminService_ProcessReport",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminProcessReportResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminServiceProcessReportBody"
            }
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/users": {
      "get": {
        "summary": "[Admin] List of users, filter banned",
        "operationId": "AdminService_ListUsers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminListUsersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "filterBanned",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/users/promote-moderator": {
      "post": {
        "summary": "[Admin] Promote a user to moderator by email",
        "operationId": "AdminService_PromoteModerator",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminPromoteModeratorResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/adminPromoteModeratorRequest"
            }
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/users/{userId}/ban": {
      "patch": {
        "summary": "[Admin] Ban/unban user",
        "operationId": "AdminService_BanUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/adminBanUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminServiceBanUserBody"
            }
          }
        ],
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "AdminServiceBanUserBody": {
      "type": "object",
      "properties": {
        "ban": {
          "type": "boolean",
          "title": "true to ban, false to unban"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "AdminServiceProcessReportBody": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "title": "\"resolve\", \"dismiss\""
        },
        "resolution": {
          "type": "string"
        },
        "adminNote": {
          "type": "string"
        }
      }
    },
    "AdminServiceUpdateDeckStatusBody": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "title": "\"hidden\", \"deleted\", \"active\""
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "adminBanUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/adminUser"
        }
      }
    },
    "adminListReportsResponse": {
      "type": "object",
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/adminReport"
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      }
    },
    "adminListUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/adminUser"
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      }
    },
    "adminProcessReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "$ref": "#/definitions/adminReport"
        }
      }
    },
    "adminPromoteModeratorRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "adminPromoteModeratorResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "adminReport": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string"
        },
        "reporterId": {
          "type": "string"
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "reasonCategory": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "assignedTo": {
          "type": "string"
        },
        "adminNote": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "resolvedBy": {
          "type": "string"
        },
        "resolvedAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "title": "Message definitions"
    },
    "adminUpdateDeckStatusResponse": {
      "type": "object",
      "properties": {
        "deckId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "adminUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "isBanned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
